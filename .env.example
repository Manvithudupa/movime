# ============================================================
# Supabase Configuration (required for auth, watchlist sync,
# profiles, and continue watching)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret key for admin operations (account deletion). MUST stay server-only -
# never prefix with NEXT_PUBLIC_.
# Get it from: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# TMDB API Configuration (required for movie/TV/anime data)
# Get a free key at: https://www.themoviedb.org/settings/api
#
# SECURITY: the server-only key below is what the app actually uses. All TMDB
# requests are proxied through /api/tmdb, which injects the key server-side so
# it never ships in the client bundle. Set this in your hosting dashboard, NOT
# as a NEXT_PUBLIC_ variable.
# ============================================================
TMDB_API_KEY=your_tmdb_key

# Legacy fallback (deprecated): only used by the proxy/server when TMDB_API_KEY
# is unset. Because it starts with NEXT_PUBLIC_, it is embedded in the client
# bundle and is visible to anyone — remove it once TMDB_API_KEY is set.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_key

# ============================================================
# Resend (required for the contact form to send email)
# Get a key at: https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=re_your_resend_key

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=you@example.com

# Optional: verified sender address. The default
# (Movime <onboarding@resend.dev>) only works for testing - verify
# a domain in Resend and switch to your own address
# (e.g. Movime <no-reply@yourdomain.com>) for production.
RESEND_EMAIL_FROM=Movime <onboarding@resend.dev>

# ============================================================
# Optional: image proxy for privacy/caching of TMDB images.
# Leave unset to use the built-in default below.
# ============================================================
NEXT_PUBLIC_IMAGE_PROXY=https://images.weserv.nl/?url=

# ============================================================
# Optional: global (cross-instance) API rate limiting via Upstash Redis.
# Without these, rate limits are enforced per serverless instance, which is
# still effective against casual abuse. With them, limits are enforced across
# ALL instances (a rotating-IP / multi-instance attacker can no longer spread
# requests). Get a free REST database at https://upstash.com
# ============================================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ============================================================
# Sentry (optional error monitoring — skip to disable, the app
# works fine without it)
# Get a DSN at: https://sentry.io -> create project -> Client Keys
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.example/1
# Optional: needed only for uploading source maps at build time
# SENTRY_AUTH_TOKEN=
