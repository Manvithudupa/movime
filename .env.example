# ============================================================
# Supabase Configuration (required for auth, watchlist sync,
# profiles, and continue watching)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# TMDB API Configuration (required for movie/TV/anime data)
# Get a free key at: https://www.themoviedb.org/settings/api
# ============================================================
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_key

# ============================================================
# Resend (required for the contact form to send email)
# Get a key at: https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=re_your_resend_key

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=you@example.com

# Optional: verified sender address. The default
# (Movime <onboarding@resend.dev>) only works for testing - verify
# a domain in Resend and switch to your own address
# (e.g. Movime <no-reply@yourdomain.com>) for production.
RESEND_EMAIL_FROM=Movime <onboarding@resend.dev>

# ============================================================
# Optional: image proxy for privacy/caching of TMDB images.
# Leave unset to use the built-in default below.
# ============================================================
NEXT_PUBLIC_IMAGE_PROXY=https://images.weserv.nl/?url=
